# Packagist はタグ名を Composer のバージョンとして解決するため、
# セマンティックバージョン以外のタグが push されるのを防ぐ。
tag_pattern='^v?(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'

invalid=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
		refs/tags/*) ;;
		*) continue ;;
	esac

	tag=${remote_ref#refs/tags/}
	if printf '%s\n' "$tag" | grep -Eq "$tag_pattern"; then
		continue
	fi

	printf 'error: タグ名がセマンティックバージョンの形式 (vX.Y.Z) ではありません: %s\n' "$tag" >&2
	invalid=1
done

exit "$invalid"