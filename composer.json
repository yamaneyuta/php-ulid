{
    "name": "yamaneyuta/ulid",
    "description": "ULID library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "yamaneyuta\\": "src/classes"
        },
        "files": [
            "src/functions/ulid.php"
        ]
    },
    "require": {
        "php-64bit": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "*",
        "squizlabs/php_codesniffer": "*"
    },
    "scripts": {
        "analyse": [
            "@analyse:legacy",
            "@analyse:latest"
        ],
        "analyse:legacy": "php8.5 tools/phpstan.phar analyse --configuration phpstan.legacy.neon",
        "analyse:latest": "php8.5 tools/phpstan.phar analyse --configuration phpstan.latest.neon",
        "coverage": "rm -rf reports && phpunit --testdox --coverage-html reports --coverage-clover=reports/clover.xml --whitelist src",
		"format": "phpcbf",
		"lint": [
            "@lint:php",
            "@lint:phpcs"
        ],
        "lint:php": "find src tests -name '*.php' -exec php -l {} \\;",
        "lint:phpcs": "phpcs",
        "test": "phpunit --testdox"
    }
}
